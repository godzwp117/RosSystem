+def part_persist(cases_run):
+    """D12/D13：重启恢复与状态文件损坏。"""
+    case = Case('D12_D13', '重启恢复已提交状态；状态文件损坏进入限制性故障状态',
+                '重启后 epoch/策略正确；损坏时拒绝一切准入与切换')
+    # 注意：状态文件必须放在 case.dir **之外** —— start_stack 每次都会清理并重建
