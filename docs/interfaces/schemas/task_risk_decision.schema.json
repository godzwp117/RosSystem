{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/godzwp117/RosSystem/docs/interfaces/schemas/task_risk_decision.schema.json",
  "title": "TaskRiskDecision",
  "description": "任务感知风险推理模块的输出。表达“某候选操作是否符合当前任务约束”的**上游风险建议**。本接口不是 SecurityGateway 的最终授权结果：即使 recommendation=ALLOW_RECOMMENDED，实际动作仍必须经过 /rg/guarded_navigate 由 Gateway 按其权威策略判定。F0 基线不含任务动态状态机，故 task_phase / policy_epoch / policy_digest 均为可选字段，缺失不得导致输入被拒绝。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "request_id",
    "event_id",
    "producer",
    "observed_at",
    "status",
    "reason",
    "evidence_refs",
    "task_id",
    "candidate_action",
    "target",
    "risk_level",
    "rule_basis"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0.0-proposed"
      ],
      "description": "接口契约版本。首版仅接受 1.0.0-proposed。"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "运行实例标识。"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "业务请求关联标识，与 PatrolNavigate.Goal.request_id 对应。仅用于业务串联，**不代表通信主体的安全身份**。"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "本次输出事件唯一标识。"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "本结论生成时间，RFC 3339（含时区）。"
    },
    "status": {
      "type": "string",
      "enum": [
        "ALLOW_RECOMMENDED",
        "BLOCK_RECOMMENDED",
        "UNKNOWN",
        "ERROR"
      ],
      "description": "风险建议。**这是上游建议，不是最终授权**：ALLOW_RECOMMENDED 不构成放行授权，仍须由 Gateway 判定；UNKNOWN 表示证据不足；ERROR 表示模块失败。UNKNOWN 与 ERROR 默认都不得推动执行。"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "人类可读的判断理由，必须与 status 一致。"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidenceRef"
      },
      "description": "证据引用。模拟数据必须显式标注 kind=MOCK。"
    },
    "extensions": {
      "type": "object",
      "description": "预留扩展位；未来字段只能放入本对象。",
      "additionalProperties": true
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "任务标识，与 PatrolNavigate.Goal.task_id 及权威 TaskPolicy 的 task_id 语义一致。"
    },
    "task_context": {
      "type": "object",
      "additionalProperties": false,
      "description": "任务上下文。整体可选。",
      "properties": {
        "task_phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "可选：当前可信任务阶段。**F0 基线不含任务动态状态机**；无权威来源时必须省略，不得用占位常量填充。"
        },
        "phase_source": {
          "type": "string",
          "enum": [
            "TRUSTED_STATE_MODEL",
            "CONFIGURATION",
            "MOCK",
            "UNKNOWN"
          ],
          "description": "可选：task_phase 的来源。MOCK 表示该阶段值来自模拟，不具备权威性。"
        }
      }
    },
    "candidate_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_resource",
        "operation"
      ],
      "description": "候选操作。必须对应当前冻结的 PatrolNavigate 业务语义，不得引入不同的导航目标语义。",
      "properties": {
        "action_resource": {
          "type": "string",
          "const": "/rg/guarded_navigate",
          "description": "候选操作的目标 Action。**固定为 /rg/guarded_navigate**：上游模块不得指定执行端 /rg/nav_execute 作为请求目标，该约束由 Schema 强制。"
        },
        "operation": {
          "type": "string",
          "enum": [
            "NAVIGATE"
          ],
          "description": "请求操作类型，当前仅支持导航。"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "x",
        "y"
      ],
      "description": "目标位姿，对应 PatrolNavigate.Goal.target（geometry_msgs/PoseStamped）的位置与坐标系部分。",
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "坐标系，须与权威 TaskPolicy 的 coordinate_frame 一致（当前基线为 map）。"
        },
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000,
          "description": "目标 x（米）。"
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000,
          "description": "目标 y（米）。"
        },
        "z": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000,
          "description": "可选：目标 z（米），默认 0。"
        }
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "NONE",
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ],
      "description": "任务风险等级。UNKNOWN 表示无法评估，不得自动降级为 NONE。"
    },
    "rule_basis": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "description": "规则依据（例如“目标 (8.0, 8.0) 超出允许区域 x∈[0,4] y∈[0,4]”）。"
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "description": "策略引用。整体可选；三个字段均为可选，缺失不得导致拒绝。",
      "properties": {
        "policy_version": {
          "type": "string",
          "maxLength": 64,
          "description": "可选：所用策略的版本标识（若来源明确）。"
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0,
          "description": "可选：策略单调序号。**F0 基线不提供该值**；仅在接入可信任务状态模型后才可填写，不得用 0 或随机值冒充。"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "可选：策略内容摘要（64 位小写十六进制 SHA-256）。**F0 基线不提供该值**；无权威来源时必须省略，不得伪造。"
        }
      }
    }
  },
  "$defs": {
    "producer": {
      "additionalProperties": false,
      "description": "输出声明者信息。**不是安全认证凭据**：producer 字段无法证明该来源已通过 DDS 认证，也不能作为身份判断依据。",
      "properties": {
        "module_version": {
          "description": "模块实现版本。与 schema_version（数据契约版本）无关，两者必须分别记录。",
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "description": "声明者名称（模块名或节点名）。属自报信息。",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "source": {
          "description": "输出提供方类型：MOCK=模拟实现（仅用于联调，不构成任何安全保证）；EXTERNAL=真实模块；UNKNOWN=未知。",
          "enum": [
            "MOCK",
            "EXTERNAL",
            "UNKNOWN"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "type": "object"
    },
    "evidenceRef": {
      "additionalProperties": false,
      "description": "证据引用及其可信级别。",
      "properties": {
        "kind": {
          "description": "证据来源可信级别。MOCK=模拟数据；RUNTIME_LOG=运行日志观察；PERMISSION_FILE_ANALYSIS=权限配置推导；CONTROLLED_SECURITY_EXPERIMENT=受控安全实验；UNIT_TEST=单元测试断言；UNKNOWN=无法归类。",
          "enum": [
            "MOCK",
            "RUNTIME_LOG",
            "PERMISSION_FILE_ANALYSIS",
            "CONTROLLED_SECURITY_EXPERIMENT",
            "UNIT_TEST",
            "UNKNOWN"
          ],
          "type": "string"
        },
        "note": {
          "description": "可选补充说明。",
          "maxLength": 256,
          "type": "string"
        },
        "ref": {
          "description": "证据定位（相对路径、日志行标识或样本标识）。必须能实际关联到对象。",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ref",
        "kind"
      ],
      "type": "object"
    }
  }
}