# colcon / ROS 2 build artefacts
/build/
/install/
/log/

# runtime evidence written by the scripts (never committed)
/logs/
/tests/evidence/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# SROS 2 material must never be committed (security/README.md)
security/keystore/
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr

# 验收证据包（Schema / 工具 / 说明纳入版本控制，导出的证据包不纳入）
/artifacts/acceptance/exports/*
!/artifacts/acceptance/exports/.gitkeep

# M2 SROS 2 密钥材料：绝不入库
/security/keystore/
/security/enclaves/

# 证据发布：published/ 是推送到证据分支前的本地暂存，功能分支不跟踪
/artifacts/acceptance/published/

# Local-only full Git history archive
/gitlog.md

# =============================================================================
# 本地大体积产物与研究用环境：一律不入库
# =============================================================================
#
# 背景：本基线供团队成员并行研发使用。任何人只要下载公开数据集或在本机训练模型，
# 工作区就会出现数十 GB 的内容；若不在此处排除，一次 `git add -A` 就可能把
# 22 GB 的 ROSPaCe 数据或模型缓存推上远端。
#
# 迁移自 feature/rospace-dataset-adapter 分支的同名规则，使团队基线默认安全。
/data/**
/data/**/*.tar.gz
/data/**/*.zip
/data/**/*.xlsx
/data/**/*.bag
/data/**/*.mcap
/data/**/*.db3
/data/**/*.pcap
/data/**/*.pcapng
/data/**/*.jsonl

# 训练产物与模型二进制
/training_runs/
/models/

# 隔离研究用虚拟环境（含 pip 自带的公开 CA 证书包，避免触发密钥材料守卫）
/.research-venv

# 第三方网页抓取物与竞赛证据包（体积大且属第三方版权内容）
/verify/
/verify_huawei_5th_cyber/

# Generated trusted commands contain local interpreter/model paths.
/config/team_modules*.local.yaml

# 研究环境生成的 keystore（含权限与治理文件）不入库
artifacts/research/**/keystore/
