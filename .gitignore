# colcon / ROS 2 build artefacts
/build/
/install/
/log/

# runtime evidence written by the scripts (never committed)
/logs/
/tests/evidence/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# SROS 2 material must never be committed (security/README.md)
security/keystore/
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr

# 验收证据包（Schema / 工具 / 说明纳入版本控制，导出的证据包不纳入）
/artifacts/acceptance/exports/*
!/artifacts/acceptance/exports/.gitkeep

# M2 SROS 2 密钥材料：绝不入库
/security/keystore/
/security/enclaves/

# 证据发布：published/ 是推送到证据分支前的本地暂存，功能分支不跟踪
/artifacts/acceptance/published/

# Local-only full Git history archive
/gitlog.md

# =============================================================================
# 公开数据集：本地下载物一律不入库
# =============================================================================
#
# 背景：ROSPaCe 精简版解压后达 25 GB（见 docs/research/DATASET_SELECTION_REPORT.md §D.3），
# 绝不可推送。其余数据集（HCRL RTPS、UNILEON rosbag2、Windrow 多模态等）同理，
# 因此这里对 /data/ 整体忽略，而不是只针对某一个数据集——避免以后每下一个数据集
# 都要再改一次 .gitignore，也避免有人用 `git add -f` 误传大文件。
#
# 为什么用"整体忽略 + 白名单"而不是逐个点名：
#   逐个点名容易漏（本次实测就漏掉过一个**文件名末尾带空格**的 CSV 分片）；
#   白名单方式让"默认不入库"成为安全默认值。
#
# 顺序很重要（本次实测踩到两个坑，请勿调整顺序）：
#   坑 1：不能写 `/data/` 把整个目录排除 —— 那样 git 不再向下遍历，
#         后面的 ! 白名单永远匹配不到。必须用 `/data/**`（排除内容但保留遍历）。
#   坑 2：gitignore 是「最后匹配者优先」。若把 *.pcap 之类兜底写在白名单**之后**，
#         它会重新覆盖白名单（access_probes/rtps.pcap 就是这么被挡掉的）。
#         因此顺序必须是：先兜底 → 再白名单。
/data/**
/data/**/*.tar.gz
/data/**/*.zip
/data/**/*.xlsx
/data/**/*.bag
/data/**/*.mcap
/data/**/*.db3
/data/**/*.pcap
/data/**/*.pcapng
/data/**/*.jsonl

# 白名单（必须放在最后，才能覆盖上面的兜底）：
# 以下体积很小、且被报告与脚本直接引用的**证据文件**应入库以支持复现。
# 合计约 43 KB，不含任何数据集原始内容。
!/data/access_probes/
!/data/access_probes/**

# 隔离研究环境（数据工程 / 机器学习实验），不入库
/.research-venv/

# 训练产物（模型二进制与运行缓存）不入库；仅提交配置与指标摘要
/training_runs/
/models/
