<?xml version="1.0" encoding="UTF-8"?>
<policy version="0.2.0">
  <enclaves>

    <enclave path="/witness">
      <profiles>
        <profile ns="/" node="m2_ingress_ingress">
          <topics subscribe="ALLOW">
            <topic>/m2/candidate_task</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/planner">
      <profiles>
        <profile ns="/" node="planner_node">
          <services request="ALLOW">
            <service>/rg/guarded_navigate/_action/send_goal</service>
            <service>/rg/guarded_navigate/_action/cancel_goal</service>
            <service>/rg/guarded_navigate/_action/get_result</service>
          </services>
          <services reply="ALLOW">
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/get_type_description</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics subscribe="ALLOW">
            <topic>/rg/guarded_navigate/_action/status</topic>
            <topic>/rg/guarded_navigate/_action/feedback</topic>
            <topic>/m2/candidate_task</topic>
          </topics>
          <topics publish="ALLOW">
            <topic>/m2/candidate_task</topic>
            <topic>rosout</topic>
            <topic>parameter_events</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/operator">
      <profiles>
        <profile ns="/" node="m2_ingress_client">
          <topics publish="ALLOW">
            <topic>/m2/candidate_task</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/gateway">
      <profiles>
        <profile ns="/" node="security_gateway">
          <services reply="ALLOW">
            <service>/rg/guarded_navigate/_action/send_goal</service>
            <service>/rg/guarded_navigate/_action/cancel_goal</service>
            <service>/rg/guarded_navigate/_action/get_result</service>
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/get_type_description</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <services request="ALLOW">
            <service>/rg/nav_execute/_action/send_goal</service>
            <service>/rg/nav_execute/_action/cancel_goal</service>
            <service>/rg/nav_execute/_action/get_result</service>
          </services>
          <topics publish="ALLOW">
            <topic>/rg/guarded_navigate/_action/status</topic>
            <topic>/rg/guarded_navigate/_action/feedback</topic>
            <topic>rosout</topic>
            <topic>parameter_events</topic>
          </topics>
          <topics subscribe="ALLOW">
            <topic>/rg/nav_execute/_action/status</topic>
            <topic>/rg/nav_execute/_action/feedback</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/navsim">
      <profiles>
        <profile ns="/" node="navigation_sim">
          <services reply="ALLOW">
            <service>/rg/nav_execute/_action/send_goal</service>
            <service>/rg/nav_execute/_action/cancel_goal</service>
            <service>/rg/nav_execute/_action/get_result</service>
            <service>~/describe_parameters</service>
            <service>~/get_parameter_types</service>
            <service>~/get_parameters</service>
            <service>~/get_type_description</service>
            <service>~/list_parameters</service>
            <service>~/set_parameters</service>
            <service>~/set_parameters_atomically</service>
          </services>
          <topics publish="ALLOW">
            <topic>/rg/nav_execute/_action/status</topic>
            <topic>/rg/nav_execute/_action/feedback</topic>
            <topic>rosout</topic>
            <topic>parameter_events</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

    <enclave path="/rogue">
      <profiles>
        <profile ns="/" node="m2_ingress_client">
          <topics publish="ALLOW">
            <topic>/m2/not_the_ingress</topic>
          </topics>
        </profile>
      </profiles>
    </enclave>

  </enclaves>
</policy>
