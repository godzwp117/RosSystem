<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rg_interfaces</name>
  <version>0.1.0</version>
  <description>
    Frozen ROS 2 interface contract for the RoboGuard minimal base.
    Owns rg_interfaces/action/PatrolNavigate, the single Action type shared by
    /rg/guarded_navigate (Planner -> Gateway) and /rg/nav_execute (Gateway -> NavigationSim).
  </description>
  <maintainer email="roboguard-maintainers@example.invalid">RoboGuard Base Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
