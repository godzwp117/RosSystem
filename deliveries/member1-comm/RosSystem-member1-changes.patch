+        assert rows['x'].tolist()==[[2.0],[3.0]]
+
+
+@pytest.mark.parametrize('name',['ROSPaCe_reduced.tar.gz','ROSPaCe_reduced.tar.gz.partial'])
+def test_unverified_official_archive_rejected_before_reading_csv(tmp_path,name):
