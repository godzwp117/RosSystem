<?xml version="1.0" encoding="UTF-8"?>
<permissions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
    <grant name="/m2_ingress">
      <subject_name>/CN=/m2_ingress</subject_name>
      <validity><not_before>2024-01-01T00:00:00</not_before><not_after>2035-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id>60</id></domains>
        <publish><topics><topic>rq/*</topic><topic>rr/*</topic><topic>/rg/candidate_task</topic></topics></publish>
        <subscribe><topics><topic>/rg/candidate_task</topic><topic>rq/*</topic></topics></subscribe>
        <relay><topics><topic>*</topic></topics></relay>
      </allow_rule>
      <default>DENY</default>
    </grant>
    <grant name="/m2_client_a">
      <subject_name>/CN=/m2_client_a</subject_name>
      <validity><not_before>2024-01-01T00:00:00</not_before><not_after>2035-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id>60</id></domains>
        <publish><topics><topic>/rg/candidate_task</topic><topic>rq/*</topic></topics></publish>
        <subscribe><topics><topic>rr/*</topic></topics></subscribe>
        <relay><topics><topic>*</topic></topics></relay>
      </allow_rule>
      <default>DENY</default>
    </grant>
    <grant name="/m2_client_b">
      <subject_name>/CN=/m2_client_b</subject_name>
      <validity><not_before>2024-01-01T00:00:00</not_before><not_after>2035-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id>60</id></domains>
        <publish><topics><topic>/rg/candidate_task</topic><topic>rq/*</topic></topics></publish>
        <subscribe><topics><topic>rr/*</topic></topics></subscribe>
        <relay><topics><topic>*</topic></topics></relay>
      </allow_rule>
      <default>DENY</default>
    </grant>
</permissions>
