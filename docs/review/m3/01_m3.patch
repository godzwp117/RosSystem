+            code, out = run(['git', '-C', REPO_ROOT, 'worktree', 'add', '--detach', worktree,
+                             ('FETCH_HEAD' if exists else 'HEAD')], timeout=300)
+            if not step('创建隔离 worktree', code == 0, out.strip()[-300:]):
