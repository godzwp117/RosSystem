#!/usr/bin/env sh
# 推送前检查：即将推送的提交树里不得包含"仅限本地"的文件。
#
# 比 pre-commit 更强：即使提交是别人用 `git add -f` 造出来的，
# 只要它出现在本次推送范围内就会被拦下。
set -eu

LOCAL_ONLY="gitlog.md"
ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue   # 删除分支，无需检查

  if [ "$remote_sha" = "$ZERO" ]; then
    # 新分支：检查该提交的完整树
    files=$(git ls-tree -r --name-only "$local_sha" || true)
  else
    # 已有分支：只检查本次新增/修改的路径
    files=$(git diff --name-only "$remote_sha" "$local_sha" || true)
  fi

  if printf '%s\n' "$files" | grep -qx "$LOCAL_ONLY"; then
    echo "ERROR(pre-push): 推送内容包含仅限本地的文件: $LOCAL_ONLY" >&2
    echo "  目标: $remote_ref" >&2
    echo "  请从提交中移除后再推送；本钩子不会自动改写历史。" >&2
    status=1
  fi
done

exit $status
